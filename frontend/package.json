{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:api": "openapi-generator-cli generate -c openapi-generator-config.yaml && npm run generate:api:clean",
    "generate:api:clean": "rimraf src/app/core/api/package.json src/app/core/api/ng-package.json src/app/core/api/tsconfig.json src/app/core/api/git_push.sh src/app/core/api/.gitignore src/app/core/api/README.md src/app/core/api/.openapi-generator-ignore",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/forms": "^21.2.24",
    "@angular/platform-browser": "^21.2.24",
    "@angular/router": "^21.2.24",
    "markdown-it": "^15.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.24",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.13.3",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.1"
    }
  }
}
